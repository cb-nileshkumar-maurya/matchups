      phase = figure out from phaseDefinition based on startBallNbr and endBallNbr using row.ball_nbr
      batsmanId = row.bat_striker_id
      bowlerId = row.bowl_striker_id
      phasewiseKey = {phase, batsmanId, bowlerId}

      phasewiseValue = currentBallProcessingMap.get(phasewiseKey)

      // wd, noball, Leg bye, bye
      phasewiseValue.runs += row.legal_runs
      phasewiseValue.balls += 1

      if (hasFour(row.highlights_id)) {
        phasewiseValue.fours += 1
      }
      if (hasSix(row.highlights_id)) {
        phasewiseValue.sixes += 1
      }

      if (row.legal_runs == 0 && row.total_runs == 0) {
        phasewiseValue.dots += 1
      }

      if (row.wkt_code != "NONE" && row.wkt_code != "run out") {
        phasewiseValue.dismissalType = row.wkt_code
      }


    }

