    private static final Map<Integer, String> highlights = new LinkedHashMap<>();
        highlights.put(8192, "TEAM_HUNDRED");
        highlights.put(4096, "TEAM_FIFTY");
        highlights.put(2048, "INJURY");
        highlights.put(1024, "MILESTONE");
        highlights.put(512, "UDRS");
        highlights.put(256, "RUNOUT_MISS");
        highlights.put(128, "DROPPED");
        highlights.put(64, "PARTNERSHIP");
        highlights.put(32, "HUNDRED");
        highlights.put(16, "FIFTY");
        highlights.put(8, "WICKET");
        highlights.put(4, "SIX");
        highlights.put(2, "FOUR");
        highlights.put(1, "OTHER");
        highlights.put(0, "NONE");
public static List<String> getEvent(Integer highlightsId) {
    List<String> events = new ArrayList<>();

    if (highlightsId == null || highlightsId <= 0) {
        return events;
    }

    int hid = highlightsId;

    for (Map.Entry<Integer, String> entry : highlights.entrySet()) {
        int code = entry.getKey();
        String value = entry.getValue();

        if (code > 1 && (hid / code) == 1) {
            events.add(value);
            hid = hid - code;
        }
    }

    return events;
}

public static boolean hasFour(Integer highlightsId) {
    return getEvent(highlightsId).contains(FOUR);
}

public static boolean hasSix(Integer highlightsId) {
    return getEvent(highlightsId).contains(SIX);
}


