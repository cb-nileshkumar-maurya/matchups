    // get all balls in that innnings
    allrows = select * from match_bbb_miniscore where match_id = ${matchId} and innings_id = ${inningsId};

    currentBallProcessingMap = phasewiseKey{phase, batsmanId, bowlerId} -> phasewiseValue{runs, balls, fours, sixes, dots, dismissalType}

    // process each ball and build the currentBallProcessingMap
    for each row in allrows {
      if ballNbr == 0 then continue to next row - don't process ahead
      if row.extra_code is wide (Wd, WD) then continue to next row - don't process ahead

      if row.wkt_code == "run out" {
